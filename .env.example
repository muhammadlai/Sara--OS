# Copy to a system environment or deploy/config.sh — not a workspace .env
# (OpenClaw ignores runtime-control keys in workspace .env files.)

# Jina (W2 discovery/research) — never commit the real key
# JINA_API_KEY=
# JINA_SEARCH_BASE=https://s.jina.ai
# JINA_READER_BASE=https://r.jina.ai
# JINA_TIMEOUT_MS=15000
# Health: node worker/cli.mjs jina-health   # CONNECTED only after a real 2xx

# W4 inbox / notifications — leave unset unless an authorized adapter exists
# GMAIL_ADAPTER_URL=
# NOTIFY_WEBHOOK_URL=

# W5 outreach — never commit tokens
# EMAIL_ADAPTER_URL=
# TEAMS_ACCESS_TOKEN=
# TEAMS_GRAPH_BASE=https://graph.microsoft.com/v1.0
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_ADAPTER_URL=

# Voicebox local studio (https://github.com/jamiepine/voicebox.git)
VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_CLIENT_ID=aitzaz-ai-2070
# VOICEBOX_TOKEN=
# VOICEBOX_TIMEOUT_MS=120000

# W6 daily worker schedule (no secrets)
# WORKER_TZ=Asia/Karachi
# WORKER_HOUR=10
# WORKER_MINUTE=0
# WORKER_QUERIES=fleet buyers UAE|equipment importers Nigeria
# WORKER_HIGH_PRIORITY_SCORE=7

# Voice Worker storage (defaults to ~/.openclaw/voice)
# OPENCLAW_HOME=
